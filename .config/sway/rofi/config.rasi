* {
    bg: #000000;
    background-color: @bg;
}

configuration {
    show-icons: true;
    icon-theme: "Papirus";
    location: 0;
    font: "NotoMono Nerd Font Mono 10";	
    display-drun: "󱓞";
}

window { 
    width: 33%;
    padding: 15 20;
    border: 3;
    border-color: #f38ba8;
    background-color: @bg;
}

mainbox {
    children: [inputbar, listview];
}

inputbar {
    padding: 0 0 0 0;
    margin: 5 0 10 0;
    children: [prompt, entry];
} 

prompt {
    text-color: #f38ba8;
    font: "NotoMono Nerd Font Mono 20";	
    margin: -6 10 0 8;
}

entry {
    text-color: #bac2de;
    placeholder-color: #bac2de80;
}

listview {
    border: 0;
    scrollbar: false;
    lines: 6;
    background-color: @bg;
    text-color: #cdd6f4;
}

element,
element.normal.normal,
element.normal.urgent,
element.normal.active,
element.alternate,
element.alternate.normal,
element.alternate.urgent,
element.alternate.active {
    padding: 10;
    text-color: inherit;
    background-color: inherit;
}

element.selected.normal,
element.selected.urgent,
element.selected.active,
element.alternate.selected.normal,
element.alternate.selected.urgent,
element.alternate.selected.active {
    border-color: #f38ba8;
    border: 1;
    text-color: inherit;
    background-color: inherit;
}

element-icon {
    margin: 0 5 0 0;
}
